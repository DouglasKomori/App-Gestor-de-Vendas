generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Unidade {
  G
  KG
  ML
  L
  UN
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())

  insumos  Insumo[]
  receitas Receita[]
}

model Insumo {
  id                       Int      @id @default(autoincrement())
  userId                   Int
  nome                     String
  unidadeCompra            Unidade
  quantidadeEmbalagem      Decimal  @db.Decimal(12, 3)
  precoEmbalagem           Decimal  @db.Decimal(10, 2)
  // Percentual aproveitado do insumo depois das perdas (casca, osso etc.).
  aproveitamentoPercentual Decimal  @default(100) @db.Decimal(5, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id])
  itens ReceitaItem[]

  @@index([userId])
}

model Receita {
  id                       Int      @id @default(autoincrement())
  userId                   Int
  nome                     String
  rendimentoPorcoes        Int
  // Gás, energia, embalagem etc., como percentual sobre o custo dos ingredientes.
  custosExtrasPercentual   Decimal  @default(0) @db.Decimal(6, 2)
  // Margem sobre o preço de venda (não é markup).
  margemDesejadaPercentual Decimal  @db.Decimal(5, 2)
  observacoes              String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id])
  itens ReceitaItem[]

  @@index([userId])
}

model ReceitaItem {
  id         Int     @id @default(autoincrement())
  receitaId  Int
  insumoId   Int
  quantidade Decimal @db.Decimal(12, 3)
  unidade    Unidade

  // Apagar a receita apaga seus itens; um insumo em uso não pode ser apagado.
  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@index([receitaId])
  @@index([insumoId])
}
