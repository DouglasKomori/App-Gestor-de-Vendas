generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Unidade {
  G
  KG
  ML
  L
  UN
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  createdAt DateTime @default(now())

  insumos  Insumo[]
  receitas Receita[]
}

model Insumo {
  id                       Int      @id @default(autoincrement())
  userId                   Int
  nome                     String
  unidadeCompra            Unidade
  quantidadeEmbalagem      Decimal  @db.Decimal(12, 3)
  precoEmbalagem           Decimal  @db.Decimal(10, 2)
  // Percentual aproveitado do insumo depois das perdas (casca, osso etc.).
  aproveitamentoPercentual Decimal  @default(100) @db.Decimal(5, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  itens   ReceitaItem[]
  medidas MedidaCaseira[]

  @@index([userId])
}

// Equivalência definida pela pessoa para um insumo: "1 colher de sopa" de manteiga = 20 g.
// Não é conversão por densidade: o valor é informado, porque varia de ingrediente para ingrediente.
model MedidaCaseira {
  id         Int     @id @default(autoincrement())
  insumoId   Int
  nome       String  @db.VarChar(60)
  quantidade Decimal @db.Decimal(12, 3)
  unidade    Unidade

  insumo Insumo        @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  itens  ReceitaItem[]

  @@unique([insumoId, nome])
}

model Receita {
  id                       Int      @id @default(autoincrement())
  userId                   Int
  nome                     String
  rendimentoPorcoes        Int
  // Gás, energia etc., como percentual sobre o custo dos ingredientes.
  custosExtrasPercentual   Decimal  @default(0) @db.Decimal(6, 2)
  // Margem sobre o preço de venda (não é markup).
  margemDesejadaPercentual Decimal  @db.Decimal(5, 2)
  // Trabalho da pessoa: tempo gasto na receita inteira e quanto ela quer ganhar por hora.
  tempoPreparoMinutos      Int      @default(0)
  valorHoraTrabalho        Decimal  @default(0) @db.Decimal(10, 2)
  // Maquininha, aplicativo de entrega etc.: percentual cobrado sobre o preço de venda.
  taxaVendaPercentual      Decimal  @default(0) @db.Decimal(5, 2)
  // Preço que a pessoa cobra hoje por porção, para comparar com o custo real.
  precoVendaPraticado      Decimal? @db.Decimal(10, 2)
  observacoes              String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id])
  itens ReceitaItem[]

  @@index([userId])
}

model ReceitaItem {
  id              Int     @id @default(autoincrement())
  receitaId       Int
  insumoId        Int
  // Com medida caseira, é o número de medidas (2 colheres) e a unidade é a da medida.
  quantidade      Decimal @db.Decimal(12, 3)
  unidade         Unidade
  medidaCaseiraId Int?

  // Apagar a receita apaga seus itens; insumo ou medida em uso não podem ser apagados.
  receita Receita        @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  insumo  Insumo         @relation(fields: [insumoId], references: [id], onDelete: Restrict)
  medida  MedidaCaseira? @relation(fields: [medidaCaseiraId], references: [id], onDelete: Restrict)

  @@index([receitaId])
  @@index([insumoId])
  @@index([medidaCaseiraId])
}
