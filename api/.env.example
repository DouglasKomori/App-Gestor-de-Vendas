# Copie este arquivo para ".env" (cp .env.example .env) e ajuste se precisar.

# Conexão com o MySQL do docker-compose.yml (usuário root, só para desenvolvimento local).
# Use 127.0.0.1 em vez de localhost: no Windows, localhost pode resolver para IPv6 e falhar.
DATABASE_URL="mysql://root:root@127.0.0.1:3306/gestor_vendas"

# Porta e endereço em que a API escuta. 0.0.0.0 permite acesso pelo celular na mesma rede.
PORT=3333
HOST=0.0.0.0

# Segredo usado para assinar os tokens de login (JWT). Obrigatório, com 32+ caracteres.
# Troque por um valor só seu. Para gerar um:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-este-texto-por-um-segredo-longo-e-aleatorio"
